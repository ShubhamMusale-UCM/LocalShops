# ==========================================
# CityLocalShop Server Environment Template
# ==========================================

NODE_ENV=development
PORT=5000

# PostgreSQL & Redis
DATABASE_URL="postgresql://postgres:password@localhost:5432/citylocalshop?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Authentication & Cryptography (MUST be changed in production)
JWT_SECRET="replace-with-at-least-16-char-random-secret-key"
JWT_REFRESH_SECRET="replace-with-at-least-16-char-random-refresh-key"
DATA_ENCRYPTION_KEY="replace-with-32-byte-hex-or-passphrase-for-aes-256-gcm"

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Object Storage (AWS S3 / Cloudflare R2)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
