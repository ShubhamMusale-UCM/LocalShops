# Server Environment Variables
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://citylocalshop:citylocalshop@localhost:5432/citylocalshop?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="citylocalshop-uploads"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Firebase Admin SDK (for Push Notifications + Firebase Auth token verification)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# SMS Provider (MSG91) - legacy, not used for login OTP after Firebase Auth migration
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="CLSHOP"
MSG91_TEMPLATE_ID=""

# App Config
DEFAULT_SEARCH_RADIUS_KM=5
PLATFORM_FEE_PERCENTAGE=3
MAX_FILE_SIZE_MB=10
CDN_BASE_URL=""

# CORS
CORS_ORIGIN="*"
